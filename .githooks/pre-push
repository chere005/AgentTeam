#!/usr/bin/env bash
# Nothing reaches main or a release tag without a passed preflight (scripts/preflight.sh): a red
# run on main or a release mails the repository owner. A commit may go when it passed preflight
# itself, or when all it changed since a commit that passed is the version numbers and the docs
# (a release's own bump and notes). AGENTTEAM_SKIP_PREFLIGHT=1 lets a push through; say why in
# the commit. Installed by `npm ci`/`npm install` (scripts/install-hooks.mjs).
set -uo pipefail

# Quiet CI first (no override): every workflow must hand a person's run to github-actions[bot] and never go red, or a
# failed run mails whoever triggered it. The checker lives in Sean's sibling AgentSuite checkout; skipped when absent.
suite="$(git rev-parse --show-toplevel)/../AgentSuite/tools/check-workflows.py"
if [ -f "$suite" ]; then
  # The first interpreter that really runs Python 3.8+. On Windows, python3/python can be the Microsoft Store shortcuts,
  # which exist on PATH but only print an install hint, so each candidate is run rather than just found; `py -3` is the
  # Windows launcher. Same order as AgentSuite's githooks/pre-push.
  py=""
  for candidate in python3 python "py -3"; do
    # shellcheck disable=SC2086
    if $candidate -c 'import sys; sys.exit(sys.version_info < (3, 8))' > /dev/null 2>&1; then
      py="$candidate"
      break
    fi
  done
  if [ -z "$py" ]; then
    echo "pre-push: refused - Python 3.8+ is needed to check the workflows (python3, python or py -3)" >&2
    exit 1
  fi
  # shellcheck disable=SC2086
  $py "$suite" "$(git rev-parse --show-toplevel)" || { echo "pre-push: refused - a workflow breaks the quiet-CI contract" >&2; exit 1; }
fi

[ "${AGENTTEAM_SKIP_PREFLIGHT:-}" = "1" ] && exit 0
mark="$(git rev-parse --git-common-dir)/preflight"
zero="0000000000000000000000000000000000000000"

trivial() {
  local from="$1" to="$2" file
  while IFS= read -r file; do
    case "$file" in
      package.json|package-lock.json|docs/*|*.md) ;;
      *) return 1 ;;
    esac
  done < <(git diff --name-only "$from" "$to")
  return 0
}

passed() {
  local commit="$1" base
  [ -f "${mark}/${commit}" ] && return 0
  [ -d "$mark" ] || return 1
  for base in "$mark"/*; do
    base="$(basename "$base")"
    git merge-base --is-ancestor "$base" "$commit" 2> /dev/null || continue
    trivial "$base" "$commit" && return 0
  done
  return 1
}

status=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  case "$remote_ref" in
    refs/heads/main|refs/tags/v*) ;;
    *) continue ;;
  esac
  commit="$(git rev-parse "${local_sha}^{commit}" 2> /dev/null)" || continue
  if ! passed "$commit"; then
    echo "pre-push: ${remote_ref#refs/*/} <- ${commit:0:7} has not passed preflight." >&2
    echo "  Run scripts/preflight.sh on its branch first (CI on GitHub that never mails a failure)." >&2
    echo "  Only a version bump and docs may follow a passed commit. AGENTTEAM_SKIP_PREFLIGHT=1 overrides." >&2
    status=1
  fi
done
exit $status
