{
  "name": "agentteam",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Visual multi-agent desktop workspace",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "node --watch src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit && tsc -p tsconfig.desktop.json --noEmit",
    "skills": "node src/cli.ts skills",
    "backend": "node src/server.ts",
    "dev:ui": "vite",
    "build": "vite build && node scripts/build.mjs",
    "prepare": "node scripts/install-hooks.mjs && node scripts/native-deps.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:ui": "npm run build && playwright test",
    "desktop": "electron .",
    "format": "prettier --write src desktop ui test e2e scripts/*.mjs *.json *.ts .github/workflows/*.yml",
    "preflight": "bash scripts/preflight.sh"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "@xyflow/react": "^12.12.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.59.0",
    "node-pty": "1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "main": "dist/desktop/main.js",
  "build": {
    "appId": "com.agentteam.desktop",
    "productName": "AgentTeam",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "author": {
    "name": "Sean Cheren",
    "email": "28164815+chere005@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chere005/AgentTeam.git"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
