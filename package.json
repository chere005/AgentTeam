{
  "name": "agentteam",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Visual multi-agent desktop workspace",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "node --watch src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "skills": "node src/cli.ts skills",
    "backend": "node src/server.ts",
    "dev:ui": "vite",
    "build": "vite build && node scripts/build.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:ui": "playwright test",
    "desktop": "electron .",
    "format": "prettier --write src desktop ui test e2e scripts/*.mjs *.json *.ts .github/workflows/*.yml",
    "preflight": "bash scripts/preflight.sh"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "main": "dist/desktop/main.js",
  "build": {
    "appId": "com.agentteam.desktop",
    "productName": "AgentTeam",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "author": {
    "name": "Sean Cheren",
    "email": "28164815+chere005@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chere005/AgentTeam.git"
  }
}
